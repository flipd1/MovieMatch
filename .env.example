# Copy this file to .env and fill in real values. Never commit .env.

# Create a project at https://supabase.com, run supabase/schema.sql in its
# SQL editor, then fill these in from Project Settings > API.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here

# Cloudflare Turnstile site key (public). Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile, add its Site Key
# here, and its Secret Key in Supabase's Auth > Attack Protection settings
# (never in this file). Required if CAPTCHA protection is enabled on the
# Supabase project — without it, anonymous sign-in will fail.
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# TMDB is called through the tmdb-proxy Edge Function, not directly from
# the frontend, so there is no TMDB variable here. The TMDB access token
# is set as a Supabase secret instead — see
# supabase/functions/tmdb-proxy/README.md for setup.
